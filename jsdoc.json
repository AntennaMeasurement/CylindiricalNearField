{
  "plugins": ["./jsdoc/formula-plugin.js"],
  "sourceType": "script",
  "source": {
    "include": [
      "index.js",
      "lib/wavelength.js",
      "lib/measurementDistance.js",
      "lib/probeRadius.js",
      "lib/scanSizeY.js",
      "lib/stepSizeY.js",
      "lib/samplingCountY.js",
      "lib/samplingParametersY.js",
      "lib/stepSizeAzimuth.js",
      "lib/samplingCountAzimuth.js"
    ]
  },
  "tags": {
    "allowUnknownTags": false,
    "dictionaries": ["jsdoc", "closure"]
  },
  "opts": {
    "destination": "./docs",
    "readme": "README.md"
  }
}