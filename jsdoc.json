{
  "plugins": ["./jsdoc/formula-plugin.js"],
  "sourceType": "script",
  "source": {
    "include": [
      "index.js",
      "lib/wavelength.js",
      "lib/measurement-distance.js",
      "lib/probe-radius.js",
      "lib/scan-size-y.js",
      "lib/step-size-y.js",
      "lib/sampling-count-y.js",
      "lib/sampling-parameters-y.js",
      "lib/step-size-azimuth.js",
      "lib/sampling-count-azimuth.js"
    ]
  },
  "tags": {
    "allowUnknownTags": false,
    "dictionaries": ["jsdoc", "closure"]
  },
  "opts": {
    "destination": "./docs",
    "readme": "README.md"
  }
}